{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dao-Shell",
  "version": "0.1.0",
  "identifier": "io.github.kestiny18.dao-shell",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "Dao-Shell", "width": 1040, "height": 760, "minWidth": 680, "minHeight": 580 }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Dao-Shell contributors",
    "shortDescription": "A small LLM-first shell for using your computer",
    "licenseFile": "../../LICENSE",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "installer-hooks.nsh",
        "startMenuFolder": "Dao-Shell"
      }
    }
  }
}
